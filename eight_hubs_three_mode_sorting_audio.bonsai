          <p2:Ch2StimulateChannel>0</p2:Ch2StimulateChannel>
          <p2:Ch2TriggerDelay>0</p2:Ch2TriggerDelay>
          <p2:Ch2PhaseOneCurrent>0</p2:Ch2PhaseOneCurrent>
          <p2:Ch2InterPhaseCurrent>0</p2:Ch2InterPhaseCurrent>
