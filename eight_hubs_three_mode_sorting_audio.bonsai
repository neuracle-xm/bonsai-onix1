<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:OpenEphys.Sockets.Bonsai;assembly=OpenEphys.Sockets.Bonsai"
                 xmlns:py="clr-namespace:Bonsai.Scripting.Python;assembly=Bonsai.Scripting.Python"
                 xmlns:p2="clr-namespace:NeuracleExtension;assembly=OpenEphys.Onix1"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:TcpServer">
          <p1:Name>Tcp1</p1:Name>
          <p1:Port>9001</p1:Port>
          <p1:Address>localhost</p1:Address>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:TcpServer">
          <p1:Name>Tcp2</p1:Name>
          <p1:Port>9002</p1:Port>
          <p1:Address>localhost</p1:Address>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:CreateRuntime">
          <py:PythonHome>python</py:PythonHome>
          <py:ScriptPath>python\main.py</py:ScriptPath>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Eval">
          <py:Expression>set_channel(0)</py:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleReadDataCache">
          <p2:CacheName>HubA/NeuracleData</p2:CacheName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:ObserveOnGIL" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Set">
          <py:VariableName>data</py:VariableName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Eval">
          <py:Expression>run(data)</py:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:ObserveOnGIL" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Get">
          <py:VariableName>result</py:VariableName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleSortingResult" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:SelectChannels">
          <dsp:Channels>
            <dsp:int>0</dsp:int>
          </dsp:Channels>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:ConvertScale">
          <dsp:Depth>F32</dsp:Depth>
          <dsp:Scale>100</dsp:Scale>
          <dsp:Shift>0</dsp:Shift>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="al:AudioPlayback">
          <al:SampleRate>44100</al:SampleRate>
          <al:State>Playing</al:State>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SendMatOverSocket">
          <p1:Connection>Tcp1</p1:Connection>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:CreateContext">
          <onix1:Driver>riffa</onix1:Driver>
          <onix1:Index>0</onix1:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubA</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubA/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>4352</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubA/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>4353</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubA/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>4354</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubA</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubB</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubB/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>8704</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubB/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>8705</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubB/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>8706</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubB</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubC</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubC/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>13056</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubC/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>13057</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubC/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>13058</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubC</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubD</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubD/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>17408</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubD/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>17409</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubD/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>17410</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubD</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubE</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubE/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>21760</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubE/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>21761</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubE/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>21762</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubE</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubF</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubF/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>26112</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubF/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>26113</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubF/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>26114</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubF</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubG</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubG/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>30464</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubG/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>30465</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubG/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>30466</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubG</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHub">
          <p2:Name>HubH</p2:Name>
          <p2:Data>
            <p2:DeviceName>HubH/NeuracleData</p2:DeviceName>
            <p2:DeviceAddress>34816</p2:DeviceAddress>
          </p2:Data>
          <p2:ElectricalStimulator>
            <p2:DeviceName>HubH/ElectricalStimulator</p2:DeviceName>
            <p2:DeviceAddress>34817</p2:DeviceAddress>
          </p2:ElectricalStimulator>
          <p2:SwitchDevice>
            <p2:DeviceName>HubH/SwitchDevice</p2:DeviceName>
            <p2:DeviceAddress>34818</p2:DeviceAddress>
          </p2:SwitchDevice>
          <p2:Hub>HubH</p2:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>393216</onix1:ReadSize>
          <onix1:WriteSize>65536</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubA/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SendMatOverSocket">
          <p1:Connection>Tcp2</p1:Connection>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubB/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubC/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubD/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubE/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubF/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubG/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHubData">
          <p2:DeviceName>HubH/NeuracleData</p2:DeviceName>
          <p2:BufferSize>3200</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToDataCache" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>LButton ShiftKey ControlKey Space Prior PageUp D0 D1 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>true</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleDataMode">
          <p2:HubName>HubA</p2:HubName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>RButton ShiftKey Menu Space Next PageDown D0 D2 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>true</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleStimulateMode">
          <p2:HubName>HubA</p2:HubName>
          <p2:Ch1Enable>false</p2:Ch1Enable>
          <p2:Ch1StimulateChannel>0</p2:Ch1StimulateChannel>
          <p2:Ch1TriggerDelay>0</p2:Ch1TriggerDelay>
          <p2:Ch1PhaseOneCurrent>0</p2:Ch1PhaseOneCurrent>
          <p2:Ch1InterPhaseCurrent>0</p2:Ch1InterPhaseCurrent>
