<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns:p1="clr-namespace:NeuracleExtension;assembly=OpenEphys.Onix1"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:CreateContext">
          <onix1:Driver>riffa</onix1:Driver>
          <onix1:Index>0</onix1:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:NeuracleConfigureHeadstage">
          <p1:Name>Headstage</p1:Name>
          <p1:HeadstageData>
            <p1:DeviceName>Headstage/NeuracleHeadstageData</p1:DeviceName>
            <p1:DeviceAddress>39168</p1:DeviceAddress>
          </p1:HeadstageData>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>393216</onix1:ReadSize>
          <onix1:WriteSize>2048</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:NeuracleHeadstageDataSource">
          <p1:DeviceName>Headstage/NeuracleHeadstageData</p1:DeviceName>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AuxData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TS4231V1DataFrame1</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeWidth</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeType</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TS4231V1DataFrame2</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeWidth</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeType</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TS4231V1DataFrame3</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeWidth</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeType</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TS4231V1DataFrame4</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeWidth</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EnvelopeType</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Bno055DataFrame</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Quaternion</Selector>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="OpenEphys.Commutator:AutoCommutator.bonsai">
          <PortName xsi:nil="true" />
          <Enable>true</Enable>
          <EnableLed>true</EnableLed>
        </Builder>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EulerAngle</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Gravity</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Acceleration</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Temperature</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Calibration</Selector>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="3" To="5" Label="Source1" />
      <Edge From="3" To="6" Label="Source1" />
      <Edge From="3" To="9" Label="Source1" />
      <Edge From="3" To="12" Label="Source1" />
      <Edge From="3" To="15" Label="Source1" />
      <Edge From="3" To="18" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="6" To="8" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="9" To="11" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="12" To="14" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="15" To="17" Label="Source1" />
      <Edge From="18" To="19" Label="Source1" />
      <Edge From="18" To="21" Label="Source1" />
      <Edge From="18" To="22" Label="Source1" />
      <Edge From="18" To="23" Label="Source1" />
      <Edge From="18" To="24" Label="Source1" />
      <Edge From="18" To="25" Label="Source1" />
      <Edge From="19" To="20" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>