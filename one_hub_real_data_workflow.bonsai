<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:OpenEphys.Sockets.Bonsai;assembly=OpenEphys.Sockets.Bonsai"
                 xmlns:py="clr-namespace:Bonsai.Scripting.Python;assembly=Bonsai.Scripting.Python"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns:p2="clr-namespace:;assembly=OpenEphys.Onix1"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns:p3="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="p1:TcpServer">
            <p1:Name>Tcp1</p1:Name>
            <p1:Port>9001</p1:Port>
            <p1:Address>localhost</p1:Address>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="p1:TcpServer">
            <p1:Name>Tcp2</p1:Name>
            <p1:Port>9002</p1:Port>
            <p1:Address>localhost</p1:Address>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:CreateRuntime">
            <py:PythonHome>python</py:PythonHome>
            <py:ScriptPath>python\main.py</py:ScriptPath>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:Eval">
            <py:Expression>set_channel(0)</py:Expression>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="onix1:ReadDataCache">
            <onix1:DeviceName>A</onix1:DeviceName>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:ObserveOnGIL" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:Set">
            <py:VariableName>data</py:VariableName>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:Eval">
            <py:Expression>run(data)</py:Expression>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:ObserveOnGIL" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="py:Get">
            <py:VariableName>result</py:VariableName>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="p2:PythonSortingResultToMat" />
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="p1:SendMatOverSocket">
            <p1:Connection>Tcp1</p1:Connection>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:CreateContext">
          <onix1:Driver>riffa</onix1:Driver>
          <onix1:Index>0</onix1:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:ConfigureHeadstage64NoAux">
          <onix1:Name>HubA</onix1:Name>
          <onix1:Rhd2164NoAux>
            <onix1:DeviceName>HubA/Rhd2164NoAux</onix1:DeviceName>
            <onix1:DeviceAddress>4352</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:DspCutoff>Dsp146mHz</onix1:DspCutoff>
            <onix1:AnalogLowCutoff>Low100mHz</onix1:AnalogLowCutoff>
            <onix1:AnalogHighCutoff>High10000Hz</onix1:AnalogHighCutoff>
          </onix1:Rhd2164NoAux>
          <onix1:ElectricalStimulator>
            <onix1:DeviceName>HubA/Headstage64ElectricalStimulator</onix1:DeviceName>
            <onix1:DeviceAddress>4353</onix1:DeviceAddress>
          </onix1:ElectricalStimulator>
          <onix1:SwitchDevice>
            <onix1:DeviceName>HubA/SwitchDevice</onix1:DeviceName>
            <onix1:DeviceAddress>4354</onix1:DeviceAddress>
          </onix1:SwitchDevice>
          <onix1:Hub>HubA</onix1:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>393216</onix1:ReadSize>
          <onix1:WriteSize>65536</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:Rhd2164DataNoAux">
          <onix1:DeviceName>HubA/Rhd2164NoAux</onix1:DeviceName>
          <onix1:BufferSize>3200</onix1:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="p1:SendMatOverSocket">
            <p1:Connection>Tcp2</p1:Connection>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:WriteToDataCache">
          <onix1:DeviceName>D</onix1:DeviceName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>LButton ShiftKey ControlKey Space Prior PageUp D0 D1 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="HasFlag">
        <Operand xsi:type="WorkflowProperty" TypeArguments="p3:Keys">
          <Value>LButton ShiftKey ControlKey Space Prior PageUp D0 D1 Control</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:SwitchToData">
          <onix1:HubName>HubA</onix1:HubName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>RButton ShiftKey Menu Space Next PageDown D0 D2 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="HasFlag">
        <Operand xsi:type="WorkflowProperty" TypeArguments="p3:Keys">
          <Value>RButton ShiftKey Menu Space Next PageDown D0 D2 Control</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:SwitchToStimulate">
          <onix1:HubName>HubA</onix1:HubName>
          <onix1:Ch1Enable>true</onix1:Ch1Enable>
          <onix1:Ch1StimulateChannel>0</onix1:Ch1StimulateChannel>
          <onix1:Ch1TriggerDelay>2000</onix1:Ch1TriggerDelay>
          <onix1:Ch1PhaseOneCurrent>1500</onix1:Ch1PhaseOneCurrent>
          <onix1:Ch1InterPhaseCurrent>0</onix1:Ch1InterPhaseCurrent>
          <onix1:Ch1PhaseTwoCurrent>-1500</onix1:Ch1PhaseTwoCurrent>
          <onix1:Ch1PhaseOneDuration>1000</onix1:Ch1PhaseOneDuration>
          <onix1:Ch1InterPhaseInterval>500</onix1:Ch1InterPhaseInterval>
          <onix1:Ch1PhaseTwoDuration>2000</onix1:Ch1PhaseTwoDuration>
          <onix1:Ch1InterPulseInterval>1000</onix1:Ch1InterPulseInterval>
          <onix1:Ch1InterBurstInterval>3000</onix1:Ch1InterBurstInterval>
          <onix1:Ch1BurstPulseCount>10</onix1:Ch1BurstPulseCount>
          <onix1:Ch1TrainBurstCount>1000</onix1:Ch1TrainBurstCount>
          <onix1:Ch1BiPhasic>true</onix1:Ch1BiPhasic>
          <onix1:Ch2Enable>false</onix1:Ch2Enable>
          <onix1:Ch2StimulateChannel>0</onix1:Ch2StimulateChannel>
          <onix1:Ch2TriggerDelay>0</onix1:Ch2TriggerDelay>
          <onix1:Ch2PhaseOneCurrent>0</onix1:Ch2PhaseOneCurrent>
          <onix1:Ch2InterPhaseCurrent>0</onix1:Ch2InterPhaseCurrent>
          <onix1:Ch2PhaseTwoCurrent>0</onix1:Ch2PhaseTwoCurrent>
          <onix1:Ch2PhaseOneDuration>0</onix1:Ch2PhaseOneDuration>
          <onix1:Ch2InterPhaseInterval>0</onix1:Ch2InterPhaseInterval>
          <onix1:Ch2PhaseTwoDuration>0</onix1:Ch2PhaseTwoDuration>
          <onix1:Ch2InterPulseInterval>0</onix1:Ch2InterPulseInterval>
          <onix1:Ch2InterBurstInterval>0</onix1:Ch2InterBurstInterval>
          <onix1:Ch2BurstPulseCount>0</onix1:Ch2BurstPulseCount>
          <onix1:Ch2TrainBurstCount>0</onix1:Ch2TrainBurstCount>
          <onix1:Ch2BiPhasic>false</onix1:Ch2BiPhasic>
          <onix1:Ch3Enable>false</onix1:Ch3Enable>
          <onix1:Ch3StimulateChannel>0</onix1:Ch3StimulateChannel>
          <onix1:Ch3TriggerDelay>0</onix1:Ch3TriggerDelay>
          <onix1:Ch3PhaseOneCurrent>0</onix1:Ch3PhaseOneCurrent>
          <onix1:Ch3InterPhaseCurrent>0</onix1:Ch3InterPhaseCurrent>
          <onix1:Ch3PhaseTwoCurrent>0</onix1:Ch3PhaseTwoCurrent>
          <onix1:Ch3PhaseOneDuration>0</onix1:Ch3PhaseOneDuration>
          <onix1:Ch3InterPhaseInterval>0</onix1:Ch3InterPhaseInterval>
          <onix1:Ch3PhaseTwoDuration>0</onix1:Ch3PhaseTwoDuration>
          <onix1:Ch3InterPulseInterval>0</onix1:Ch3InterPulseInterval>
          <onix1:Ch3InterBurstInterval>0</onix1:Ch3InterBurstInterval>
          <onix1:Ch3BurstPulseCount>0</onix1:Ch3BurstPulseCount>
          <onix1:Ch3TrainBurstCount>0</onix1:Ch3TrainBurstCount>
          <onix1:Ch3BiPhasic>false</onix1:Ch3BiPhasic>
          <onix1:Ch4Enable>false</onix1:Ch4Enable>
          <onix1:Ch4StimulateChannel>0</onix1:Ch4StimulateChannel>
          <onix1:Ch4TriggerDelay>0</onix1:Ch4TriggerDelay>
          <onix1:Ch4PhaseOneCurrent>0</onix1:Ch4PhaseOneCurrent>
          <onix1:Ch4InterPhaseCurrent>0</onix1:Ch4InterPhaseCurrent>
          <onix1:Ch4PhaseTwoCurrent>0</onix1:Ch4PhaseTwoCurrent>
          <onix1:Ch4PhaseOneDuration>0</onix1:Ch4PhaseOneDuration>
          <onix1:Ch4InterPhaseInterval>0</onix1:Ch4InterPhaseInterval>
          <onix1:Ch4PhaseTwoDuration>0</onix1:Ch4PhaseTwoDuration>
          <onix1:Ch4InterPulseInterval>0</onix1:Ch4InterPulseInterval>
          <onix1:Ch4InterBurstInterval>0</onix1:Ch4InterBurstInterval>
          <onix1:Ch4BurstPulseCount>0</onix1:Ch4BurstPulseCount>
          <onix1:Ch4TrainBurstCount>0</onix1:Ch4TrainBurstCount>
          <onix1:Ch4BiPhasic>false</onix1:Ch4BiPhasic>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>LButton RButton Cancel ShiftKey ControlKey Menu Pause Space Prior PageUp Next PageDown End D0 D1 D2 D3 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="HasFlag">
        <Operand xsi:type="WorkflowProperty" TypeArguments="p3:Keys">
          <Value>LButton RButton Cancel ShiftKey ControlKey Menu Pause Space Prior PageUp Next PageDown End D0 D1 D2 D3 Control</Value>
        </Operand>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:SwitchToImpedanceMode">
          <onix1:HubName>HubA</onix1:HubName>
          <onix1:ChannelIndex>3</onix1:ChannelIndex>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="2" To="3" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="15" To="16" Label="Source1" />
      <Edge From="15" To="18" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="16" To="19" Label="Source1" />
      <Edge From="20" To="21" Label="Source1" />
      <Edge From="21" To="22" Label="Source1" />
      <Edge From="23" To="24" Label="Source1" />
      <Edge From="24" To="25" Label="Source1" />
      <Edge From="26" To="27" Label="Source1" />
      <Edge From="27" To="28" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>