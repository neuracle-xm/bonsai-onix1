<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns:p1="clr-namespace:NeuracleExtension;assembly=OpenEphys.Onix1"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:CreateContext">
          <onix1:Driver>riffa</onix1:Driver>
          <onix1:Index>0</onix1:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:NeuracleConfigureHub">
          <p1:Name>HubA</p1:Name>
          <p1:Data>
            <p1:DeviceName>HubA/NeuracleData</p1:DeviceName>
            <p1:DeviceAddress>4352</p1:DeviceAddress>
          </p1:Data>
          <p1:ElectricalStimulator>
            <p1:DeviceName>HubA/ElectricalStimulator</p1:DeviceName>
            <p1:DeviceAddress>4353</p1:DeviceAddress>
          </p1:ElectricalStimulator>
          <p1:SwitchDevice>
            <p1:DeviceName>HubA/SwitchDevice</p1:DeviceName>
            <p1:DeviceAddress>4354</p1:DeviceAddress>
          </p1:SwitchDevice>
          <p1:Hub>HubA</p1:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>2048</onix1:ReadSize>
          <onix1:WriteSize>2048</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:NeuracleHubData">
          <p1:DeviceName>HubA/NeuracleData</p1:DeviceName>
          <p1:BufferSize>3200</p1:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:MatrixWriter">
          <dsp:Suffix>None</dsp:Suffix>
          <dsp:Overwrite>false</dsp:Overwrite>
          <dsp:Layout>ColumnMajor</dsp:Layout>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="0" To="1" Label="Source1" />
      <Edge From="1" To="2" Label="Source1" />
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="4" To="5" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>