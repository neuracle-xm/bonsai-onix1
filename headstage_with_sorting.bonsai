<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.8.5"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:p1="clr-namespace:OpenEphys.Sockets.Bonsai;assembly=OpenEphys.Sockets.Bonsai"
                 xmlns:py="clr-namespace:Bonsai.Scripting.Python;assembly=Bonsai.Scripting.Python"
                 xmlns:p2="clr-namespace:NeuracleExtension;assembly=OpenEphys.Onix1"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:al="clr-namespace:Bonsai.Audio;assembly=Bonsai.Audio"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns:wie="clr-namespace:Bonsai.Windows.Input;assembly=Bonsai.Windows.Input"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:TcpServer">
          <p1:Name>Tcp1</p1:Name>
          <p1:Port>9001</p1:Port>
          <p1:Address>localhost</p1:Address>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:TcpServer">
          <p1:Name>Tcp2</p1:Name>
          <p1:Port>9002</p1:Port>
          <p1:Address>localhost</p1:Address>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:TcpServer">
          <p1:Name>Tcp3</p1:Name>
          <p1:Port>9003</p1:Port>
          <p1:Address>localhost</p1:Address>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:CreateRuntime">
          <py:PythonHome>python</py:PythonHome>
          <py:ScriptPath>python\headstage.py</py:ScriptPath>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Eval">
          <py:Expression>set_channel(0)</py:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleReadHeadstageDataCache">
          <p2:CacheName>HeadstageA/NeuracleHeadstageData</p2:CacheName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:ObserveOnGIL" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Set">
          <py:VariableName>data</py:VariableName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Eval">
          <py:Expression>run(data)</py:Expression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:ObserveOnGIL" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="py:Get">
          <py:VariableName>result</py:VariableName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleSortingResult" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:SelectChannels">
          <dsp:Channels>
            <dsp:int>0</dsp:int>
          </dsp:Channels>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:ConvertScale">
          <dsp:Depth>F32</dsp:Depth>
          <dsp:Scale>100</dsp:Scale>
          <dsp:Shift>0</dsp:Shift>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="al:AudioPlayback">
          <al:SampleRate>44100</al:SampleRate>
          <al:State>Playing</al:State>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SendMatOverSocket">
          <p1:Connection>Tcp1</p1:Connection>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:CreateContext">
          <onix1:Driver>riffa</onix1:Driver>
          <onix1:Index>0</onix1:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHeadstage">
          <p2:Name>HeadstageA</p2:Name>
          <p2:HeadstageData>
            <p2:DeviceName>HeadstageA/NeuracleHeadstageData</p2:DeviceName>
            <p2:DeviceAddress>39168</p2:DeviceAddress>
          </p2:HeadstageData>
          <p2:HeadstageStimulator>
            <p2:DeviceName>HeadstageA/HeadstageStimulator</p2:DeviceName>
            <p2:DeviceAddress>39169</p2:DeviceAddress>
          </p2:HeadstageStimulator>
          <p2:HeadstageName>HeadstageA</p2:HeadstageName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleConfigureHeadstage">
          <p2:Name>HeadstageB</p2:Name>
          <p2:HeadstageData>
            <p2:DeviceName>HeadstageB/NeuracleHeadstageData</p2:DeviceName>
            <p2:DeviceAddress>43520</p2:DeviceAddress>
          </p2:HeadstageData>
          <p2:HeadstageStimulator>
            <p2:DeviceName>HeadstageB/HeadstageStimulator</p2:DeviceName>
            <p2:DeviceAddress>43521</p2:DeviceAddress>
          </p2:HeadstageStimulator>
          <p2:HeadstageName>HeadstageB</p2:HeadstageName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>393216</onix1:ReadSize>
          <onix1:WriteSize>2048</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHeadstageDataSource">
          <p2:DeviceName>HeadstageA/NeuracleHeadstageData</p2:DeviceName>
          <p2:BufferSize>3000</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SendMatOverSocket">
          <p1:Connection>Tcp2</p1:Connection>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToHeadstageDataCache" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AuxData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Bno055DataFrame</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Quaternion</Selector>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="OpenEphys.Commutator:AutoCommutator.bonsai">
          <PortName xsi:nil="true" />
          <Enable>true</Enable>
          <EnableLed>true</EnableLed>
        </Builder>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EulerAngle</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Gravity</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Acceleration</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Temperature</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Calibration</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHeadstageDataSource">
          <p2:DeviceName>HeadstageB/NeuracleHeadstageData</p2:DeviceName>
          <p2:BufferSize>3000</p2:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:SendMatOverSocket">
          <p1:Connection>Tcp3</p1:Connection>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleWriteToHeadstageDataCache" />
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>ImpedanceValue</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AuxData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Bno055DataFrame</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Quaternion</Selector>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="IncludeWorkflow" Path="OpenEphys.Commutator:AutoCommutator.bonsai">
          <PortName xsi:nil="true" />
          <Enable>true</Enable>
          <EnableLed>true</EnableLed>
        </Builder>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EulerAngle</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Gravity</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Acceleration</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Temperature</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Calibration</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>LButton ShiftKey ControlKey Space Prior PageUp D0 D1 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>true</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHeadstageDataMode">
          <p2:DeviceName>HeadstageA/NeuracleHeadstageData</p2:DeviceName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>RButton ShiftKey Menu Space Next PageDown D0 D2 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>true</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHeadstageStimulateMode">
          <p2:DeviceName>HeadstageA/HeadstageStimulator</p2:DeviceName>
          <p2:Ch1TriggerDelay>0</p2:Ch1TriggerDelay>
          <p2:Ch1PhaseOneCurrent>0</p2:Ch1PhaseOneCurrent>
          <p2:Ch1InterPhaseCurrent>0</p2:Ch1InterPhaseCurrent>
          <p2:Ch1PhaseTwoCurrent>0</p2:Ch1PhaseTwoCurrent>
          <p2:Ch1PhaseOneDuration>0</p2:Ch1PhaseOneDuration>
          <p2:Ch1InterPhaseInterval>0</p2:Ch1InterPhaseInterval>
          <p2:Ch1PhaseTwoDuration>0</p2:Ch1PhaseTwoDuration>
          <p2:Ch1InterPulseInterval>0</p2:Ch1InterPulseInterval>
          <p2:Ch1InterBurstInterval>0</p2:Ch1InterBurstInterval>
          <p2:Ch1BurstPulseCount>1</p2:Ch1BurstPulseCount>
          <p2:Ch1TrainBurstCount>1</p2:Ch1TrainBurstCount>
          <p2:Ch1BiPhasic>false</p2:Ch1BiPhasic>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="wie:KeyDown">
          <wie:Filter>LButton RButton Cancel ShiftKey ControlKey Menu Pause Space Prior PageUp Next PageDown End D0 D1 D2 D3 Control</wie:Filter>
          <wie:SuppressRepetitions>false</wie:SuppressRepetitions>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="BooleanProperty">
          <Value>true</Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:NeuracleHeadstageImpedanceMode">
          <p2:DeviceName>HeadstageA/NeuracleHeadstageData</p2:DeviceName>
          <p2:ChannelIndex>0</p2:ChannelIndex>
        </Combinator>
      </Expression>
    </Nodes>
    <Edges>
      <Edge From="3" To="4" Label="Source1" />
      <Edge From="5" To="6" Label="Source1" />
      <Edge From="6" To="7" Label="Source1" />
      <Edge From="7" To="8" Label="Source1" />
      <Edge From="8" To="9" Label="Source1" />
      <Edge From="9" To="10" Label="Source1" />
      <Edge From="10" To="11" Label="Source1" />
      <Edge From="11" To="12" Label="Source1" />
      <Edge From="11" To="15" Label="Source1" />
      <Edge From="12" To="13" Label="Source1" />
      <Edge From="13" To="14" Label="Source1" />
      <Edge From="16" To="17" Label="Source1" />
      <Edge From="17" To="18" Label="Source1" />
      <Edge From="18" To="19" Label="Source1" />
      <Edge From="20" To="21" Label="Source1" />
      <Edge From="20" To="23" Label="Source1" />
      <Edge From="20" To="24" Label="Source1" />
      <Edge From="20" To="25" Label="Source1" />
      <Edge From="20" To="26" Label="Source1" />
      <Edge From="21" To="22" Label="Source1" />
      <Edge From="26" To="27" Label="Source1" />
      <Edge From="26" To="29" Label="Source1" />
      <Edge From="26" To="30" Label="Source1" />
      <Edge From="26" To="31" Label="Source1" />
      <Edge From="26" To="32" Label="Source1" />
      <Edge From="26" To="33" Label="Source1" />
      <Edge From="27" To="28" Label="Source1" />
      <Edge From="34" To="35" Label="Source1" />
      <Edge From="34" To="37" Label="Source1" />
      <Edge From="34" To="38" Label="Source1" />
      <Edge From="34" To="39" Label="Source1" />
      <Edge From="34" To="40" Label="Source1" />
      <Edge From="35" To="36" Label="Source1" />
      <Edge From="40" To="41" Label="Source1" />
      <Edge From="40" To="43" Label="Source1" />
      <Edge From="40" To="44" Label="Source1" />
      <Edge From="40" To="45" Label="Source1" />
      <Edge From="40" To="46" Label="Source1" />
      <Edge From="40" To="47" Label="Source1" />
      <Edge From="41" To="42" Label="Source1" />
      <Edge From="48" To="49" Label="Source1" />
      <Edge From="49" To="50" Label="Source1" />
      <Edge From="51" To="52" Label="Source1" />
      <Edge From="52" To="53" Label="Source1" />
      <Edge From="54" To="55" Label="Source1" />
      <Edge From="55" To="56" Label="Source1" />
    </Edges>
  </Workflow>
</WorkflowBuilder>