            <onix1:DeviceAddress>34818</onix1:DeviceAddress>
          </onix1:SwitchDevice>
          <onix1:Hub>HubH</onix1:Hub>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>393216</onix1:ReadSize>
          <onix1:WriteSize>65536</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:Rhd2164DataNoAux">
          <onix1:DeviceName>HubA/Rhd2164NoAux</onix1:DeviceName>
          <onix1:BufferSize>3200</onix1:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:WriteToDataCache">
          <onix1:DeviceName>A</onix1:DeviceName>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:Rhd2164DataNoAux">
          <onix1:DeviceName>HubB/Rhd2164NoAux</onix1:DeviceName>
          <onix1:BufferSize>3200</onix1:BufferSize>
        </Combinator>
      </Expression>
