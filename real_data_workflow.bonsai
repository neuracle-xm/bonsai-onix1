          <onix1:SwitchDevice>
            <onix1:DeviceName>HubC/SwitchDevice</onix1:DeviceName>
            <onix1:DeviceAddress>13058</onix1:DeviceAddress>
          </onix1:SwitchDevice>
          <onix1:Hub>HubC</onix1:Hub>
