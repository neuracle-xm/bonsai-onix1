      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:ConfigureHeadstage64NoAux">
          <onix1:Name>HubE</onix1:Name>
          <onix1:Rhd2164NoAux>
            <onix1:DeviceName>HubE/Rhd2164NoAux</onix1:DeviceName>
