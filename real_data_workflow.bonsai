      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:ConfigureHeadstage64NoAux">
          <onix1:Name>HubD</onix1:Name>
          <onix1:Rhd2164NoAux>
            <onix1:DeviceName>HubD/Rhd2164NoAux</onix1:DeviceName>
            <onix1:DeviceAddress>17408</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:DspCutoff>Dsp146mHz</onix1:DspCutoff>
            <onix1:AnalogLowCutoff>Low100mHz</onix1:AnalogLowCutoff>
            <onix1:AnalogHighCutoff>High10000Hz</onix1:AnalogHighCutoff>
          </onix1:Rhd2164NoAux>
          <onix1:ElectricalStimulator>
